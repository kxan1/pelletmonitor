# --- PostgreSQL ---
# Local dev example: postgresql://postgres:password@localhost:5432/feeder_db
# Neon/Render/Railway will give you a full connection string to paste here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/feeder_db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Ingestion protection ---
# The bridge script (and only the bridge script) must send this header:
# X-Ingest-Key: <this value>
INGEST_API_KEY=change-this-too

# --- Blynk (used only by blynk_bridge.py) ---
BLYNK_AUTH_TOKEN=your-blynk-device-auth-token
BLYNK_SERVER=https://blynk.cloud
# Map YOUR virtual pins here (must match what your ESP32 sketch already writes to)
BLYNK_VPIN_VOLTAGE=V0
BLYNK_VPIN_CURRENT=V1
BLYNK_VPIN_POWER=V2
BLYNK_VPIN_BATTERY=V3

# Where the bridge sends data (your own FastAPI, once deployed or running locally)
INGEST_URL=http://localhost:8000/ingest
POLL_INTERVAL_SECONDS=5

# --- Gemini (optional, added later) ---
GEMINI_API_KEY=your-gemini-key

# --- Multi-machine support ---
# This bridge instance polls Blynk for ONE physical machine. To support a
# second machine, deploy a second bridge instance with a different
# BLYNK_AUTH_TOKEN and DEVICE_ID, pointing at the same backend.
DEVICE_ID=esp32-feeder-01

# --- Default admin account (seeded on first boot, and auto-recreated if
# the users table is ever completely emptied). Kept simple for demo/grading
# access — CHANGE THIS before any real public deployment.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin

# --- Email verification (optional, OFF by default) ---
# Turn on only after testing delivery yourself — see backend/app/email_utils.py
# for setup notes (Gmail App Password, or any SMTP-compatible provider).
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Chicken Feeder Monitor
FRONTEND_BASE_URL=http://localhost:5173
